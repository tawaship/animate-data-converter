{
  "name": "@tawaship/animate-data-converter",
  "version": "0.1.0",
  "description": "Reads Adobe Animate HTML5 Canvas publish output and extracts engine-independent symbol and timeline definitions.",
  "main": "dist/animate-data-converter.cjs.js",
  "types": "types/index.d.ts",
  "files": [
    "dist",
    "types",
    "bin"
  ],
  "scripts": {
    "rollup": "rollup -c --bundleConfigAsCjs",
    "d": "tsc --emitDeclarationOnly --declaration --outDir ./types",
    "build": "npm run rollup -- --environment PROD && npm run d && echo done.",
    "docs": "typedoc"
  },
  "keywords": [
    "createjs",
    "adobe-animate"
  ],
  "author": "tawaship",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tawaship/animate-data-converter.git"
  },
  "bugs": {
    "url": "https://github.com/tawaship/animate-data-converter/issues"
  },
  "homepage": "https://tawaship.github.io/animate-data-converter/",
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/node": "^20.19.43",
    "del": "^8.0.1",
    "rollup": "^4.62.2",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "bin": {
    "animate-data-converter": "bin/animate-data-converter.js"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@jitl/quickjs-wasmfile-release-sync": "^0.32.0",
    "@tawaship/createjs-module": "^1.1.0",
    "quickjs-emscripten-core": "^0.32.0"
  }
}
